# ===========================================================================
# IMPORTANT: these are BUILD-TIME values.
#
# Vite inlines every VITE_* variable into the JavaScript bundle when the
# frontend is built. Setting them on the running container does nothing — the
# value is already baked in. Change one and you must rebuild the frontend.
# ===========================================================================

# ---------------------------------------------------------------------------
# API location. For a normal deployment where the frontend and the API are
# served from the SAME domain (nginx proxying /api to the backend), LEAVE BOTH
# BLANK. The app then uses the relative path /api, which resolves to whatever
# host the user actually opened — correct for every user automatically.
#
# Only set them when the API lives on a DIFFERENT origin from the frontend.
#
# Do NOT copy a localhost value into a production build. A bundle built with
# VITE_API_BASE_URL=http://localhost:3000/api tells every user's browser to
# call its OWN machine, so the deployed app fails for everyone but someone
# running the backend locally.
# ---------------------------------------------------------------------------

# API requests, including the /api prefix. Blank -> /api (same origin).
VITE_API_BASE_URL=

# Non-API connections, i.e. the WebSocket for live updates. No /api prefix.
# Blank -> derived from VITE_API_BASE_URL, or the page's own origin.
VITE_API_URL=

# ---------------------------------------------------------------------------
# NEVER SET THIS IN PRODUCTION
# ---------------------------------------------------------------------------
# Shows the one-click demo role buttons on the login page. They are on
# automatically in `npm run dev`. The local Docker sandbox sets it in the root
# .env (it is a build arg there). Setting it true in a deployed build puts demo sign-in buttons on
# a public login page.
# VITE_SHOW_DEMO_LOGINS=true
